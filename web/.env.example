# Clave que usa Paperclip para subir publicaciones (POST /api/publications)
PAPERCLIP_API_KEY=

# Clave del panel de administración (/panel)
PANEL_PASSWORD=
ANGIBELL_WEB_PORT=3002

# Base de datos unificada PostgreSQL 17
POSTGRES_USER=angibell
POSTGRES_PASSWORD=
POSTGRES_DB=angibell360
POSTGRES_PORT=5432
DATABASE_URL=

# Carpeta de datos locales (fotos subidas)
DATA_DIR=./data

# API comercial que atiende la tienda, el panel y el simulador web.
# start-demo.sh crea una clave interna aleatoria en web/.env si falta.
ANGIBELL_API_URL=http://api:4000
ANGIBELL_ADMIN_SERVICE_KEY=
WHATSAPP_BRIDGE_ENABLED=false
WPPCONNECT_SECRET_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_API_KEY=
WPPCONNECT_BASE_URL=http://host.docker.internal:21465
PUBLIC_BASE_URL=
PUBLIC_MEDIA_BASE_URL=
META_PANEL_RETURN_URL=http://localhost:3002/panel
SALES_ADMIN_PHONE=51995992450
META_GRAPH_API_VERSION=v26.0
META_PUBLISH_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://TU-URL.trycloudflare.com/v1/admin/meta/facebook/oauth/callback
# Genera con: openssl rand -hex 32. Mantener privada; cifrado AES-256-GCM de tokens de Página.
META_TOKEN_ENCRYPTION_KEY=
META_INSTAGRAM_USER_ID=
META_FACEBOOK_PAGE_ID=
