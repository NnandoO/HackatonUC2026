# Clave que usa Paperclip para subir publicaciones (POST /api/publications)
PAPERCLIP_API_KEY=

# Clave del panel de administración (/panel)
PANEL_PASSWORD=

# Almacén ERPNext (también se puede configurar desde /panel → Almacén)
# Dentro de Docker Compose el host es "frontend"; desde el host, http://localhost:8080
ERPNEXT_URL=http://frontend:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Carpeta de datos locales (SQLite + fotos subidas)
DATA_DIR=./data

# API comercial que atiende el simulador web.
# start-demo.sh crea una clave interna aleatoria en web/.env si falta.
ANGIBELL_API_URL=http://api:4000
ANGIBELL_ADMIN_SERVICE_KEY=
WHATSAPP_BRIDGE_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
PUBLIC_BASE_URL=
SALES_ADMIN_PHONE=51995992450
META_GRAPH_API_VERSION=v26.0
META_INSTAGRAM_USER_ID=
META_FACEBOOK_PAGE_ID=
